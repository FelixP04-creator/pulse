# ───────── App (öffentlich im Bundle – enthält KEINE Geheimnisse) ─────────
# Der anon-Key ist für den Client vorgesehen; der Schutz kommt von Row-Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ───────── Edge-Function-Secrets (NUR serverseitig, per `supabase secrets set --env-file`) ─────────
# NIEMALS mit EXPO_PUBLIC_ präfixen und nie committen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# https://YOUR-PROJECT.functions.supabase.co/google-health-oauth-callback
GOOGLE_REDIRECT_URI=
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# openssl rand -base64 32
OAUTH_STATE_SECRET=
# Deep-Link zurück in die App
APP_DEEP_LINK=pulse://data-sources
# Voller Wert des Authorization-Headers, den Google beim Webhook mitsendet (z. B. "Bearer <zufälliger Wert>")
WEBHOOK_AUTHORIZATION=
# Optional: KI-Coach und Foto-Erkennung. Ohne Schlüssel arbeitet die App mit regelbasiertem Coach und manueller Eingabe.
ANTHROPIC_API_KEY=
COACH_MODEL=
FOOD_MODEL=
