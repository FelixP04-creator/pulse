{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": []
  },
  "include": [
    "src/core/**/*.ts",
    "src/data/demo.ts",
    "supabase/functions/_shared/**/*.ts"
  ],
  "exclude": [
    "supabase/functions/_shared/env.ts",
    "supabase/functions/_shared/supabase.ts"
  ]
}